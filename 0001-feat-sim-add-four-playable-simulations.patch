@@ -0,0 +1,206 @@
+"use client";
+
+import { useEffect, useMemo, useState } from "react";
+import { CheckCircle2, RotateCcw, XCircle } from "lucide-react";
+import { shuffled } from "@/lib/sim";
+import { domains, quizQuestion, shapeFor, validLonePairs } from "@/lib/sim-vsepr";
+import { ScoreBar, ghostBtn, primaryBtn } from "./SimUI";
+
+const SIZE = 300;
+const R = 100;
+
+function useAngle(paused: boolean) {
+  const [angle, setAngle] = useState(0.6);
+  useEffect(() => {
+    if (paused) return;
+    let id = 0;
+    let last = performance.now();
+    const tick = (now: number) => {
+      setAngle((a) => a + ((now - last) / 1000) * 0.7);
+      last = now;
+      id = requestAnimationFrame(tick);
+    };
+    id = requestAnimationFrame(tick);
+    return () => cancelAnimationFrame(id);
+  }, [paused]);
+  return angle;
+}
+
+function Molecule({ bonded, lone, spin }: { bonded: number; lone: number; spin: number }) {
+  const items = useMemo(() => domains(bonded, lone), [bonded, lone]);
+  const tilt = 0.35;
+  const placed = items
+    .map((d) => {
+      const [x, y, z] = d.vec;
+      const x1 = x * Math.cos(spin) + z * Math.sin(spin);
+      const z1 = -x * Math.sin(spin) + z * Math.cos(spin);
+      const y2 = y * Math.cos(tilt) - z1 * Math.sin(tilt);
+      const z2 = y * Math.sin(tilt) + z1 * Math.cos(tilt);
+      const k = 1 / (1 - z2 * 0.16);
+      return { kind: d.kind, x: SIZE / 2 + x1 * R * k, y: SIZE / 2 - y2 * R * k, z: z2, k };
+    })
+    .sort((a, b) => a.z - b.z);
+
+  return (
+    <svg viewBox={`0 0 ${SIZE} ${SIZE}`} className="mx-auto block h-auto w-full max-w-sm" role="img" aria-label={`${bonded} bonded atoms and ${lone} lone pairs`}>
+      {placed.map((p, i) =>
+        p.kind === "bond" ? (
+          <line key={`l${i}`} x1={SIZE / 2} y1={SIZE / 2} x2={p.x} y2={p.y} stroke="#075985" strokeWidth={4 * p.k} strokeLinecap="round" opacity={0.35 + 0.4 * p.k} />
+        ) : null,
+      )}
+      {placed.map((p, i) =>
+        p.kind === "bond" ? (
+          <circle key={`a${i}`} cx={p.x} cy={p.y} r={13 * p.k} fill="#CC310E" stroke="white" strokeWidth="2" />
+        ) : (
+          <g key={`p${i}`} opacity={0.5 + 0.4 * p.k}>
+            <ellipse cx={SIZE / 2 + (p.x - SIZE / 2) * 0.62} cy={SIZE / 2 + (p.y - SIZE / 2) * 0.62} rx={20 * p.k} ry={13 * p.k} fill="#7DD3FC" stroke="#0284C7" strokeDasharray="3 3" />
+            <circle cx={SIZE / 2 + (p.x - SIZE / 2) * 0.62 - 5} cy={SIZE / 2 + (p.y - SIZE / 2) * 0.62} r="2.5" fill="#075985" />
+            <circle cx={SIZE / 2 + (p.x - SIZE / 2) * 0.62 + 5} cy={SIZE / 2 + (p.y - SIZE / 2) * 0.62} r="2.5" fill="#075985" />
+          </g>
+        ),
+      )}
+      <circle cx={SIZE / 2} cy={SIZE / 2} r="17" fill="#0369A1" stroke="white" strokeWidth="2" />
+      <text x={SIZE / 2} y={SIZE / 2 + 4} textAnchor="middle" fontSize="12" fontWeight="800" fill="white">A</text>
+    </svg>
+  );
+}
+
+export default function MoleculeShapes() {
+  const [mode, setMode] = useState<"explore" | "quiz">("explore");
+  const [steric, setSteric] = useState(4);
+  const [lone, setLone] = useState(0);
+  const [round, setRound] = useState(0);
+  const [picked, setPicked] = useState<string | null>(null);
+  const [score, setScore] = useState(0);
+  const [answered, setAnswered] = useState(0);
+  const spin = useAngle(false);
+
+  const question = useMemo(() => quizQuestion(round, shuffled), [round]);
+  const shape = mode === "quiz" ? question.shape : shapeFor(steric - lone, lone);
+  const bonded = shape?.bonded ?? 4;
+  const lp = shape?.lone ?? 0;
+
+  const chooseSteric = (s: number) => {
+    setSteric(s);
+    const valid = validLonePairs(s);
+    if (!valid.includes(lone)) setLone(valid[valid.length - 1]);
+  };
+
+  const answer = (name: string) => {
+    if (picked) return;
+    setPicked(name);
+    setAnswered((a) => a + 1);
+    if (name === question.shape.name) setScore((s) => s + 1);
+  };
+
+  const switchMode = (m: "explore" | "quiz") => {
+    setMode(m);
+    setPicked(null);
+  };
+
+  return (
+    <div className="space-y-5">
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <div role="tablist" aria-label="Mode" className="grid grid-cols-2 rounded-full bg-sky-100 p-1 text-sm font-bold">
+          {(["explore", "quiz"] as const).map((m) => (
+            <button
+              key={m}
+              role="tab"
+              type="button"
+              aria-selected={mode === m}
+              onClick={() => switchMode(m)}
+              className={`rounded-full px-4 py-1.5 capitalize transition ${mode === m ? "bg-sky-600 text-white" : "text-slate-600"}`}
+            >
+              {m}
+            </button>
+          ))}
+        </div>
+        {mode === "quiz" && <ScoreBar items={[{ label: "Correct", value: `${score}/${answered}` }]} />}
+      </div>
+
+      <div className="grid gap-6 lg:grid-cols-2">
+        <div className="rounded-2xl border border-sky-200 bg-gradient-to-b from-sky-50 to-white p-3">
+          <Molecule bonded={bonded} lone={lp} spin={spin} />
+          <p className="text-center text-xs text-slate-500">
+            <span className="font-bold text-[#CC310E]">●</span> bonded atom &nbsp; <span className="font-bold text-sky-500">◖</span> lone pair
+          </p>
+        </div>
+
+        <div className="space-y-4">
+          {mode === "explore" ? (
+            <>
+              <div>
+                <p className="mb-1.5 text-sm font-semibold text-slate-700">Electron domains around the central atom</p>
+                <div className="grid grid-cols-5 gap-2">
+                  {[2, 3, 4, 5, 6].map((s) => (
+                    <button key={s} type="button" onClick={() => chooseSteric(s)} aria-pressed={steric === s}
+                      className={`rounded-lg border py-2 text-sm font-extrabold transition ${steric === s ? "border-sky-600 bg-sky-600 text-white" : "border-sky-200 bg-white text-slate-700 hover:border-sky-400"}`}>
+                      {s}
+                    </button>
+                  ))}
+                </div>
+              </div>
+              <div>
+                <p className="mb-1.5 text-sm font-semibold text-slate-700">Lone pairs</p>
+                <div className="flex gap-2">
+                  {validLonePairs(steric).map((n) => (
+                    <button key={n} type="button" onClick={() => setLone(n)} aria-pressed={lone === n}
+                      className={`h-10 w-10 rounded-lg border text-sm font-extrabold transition ${lone === n ? "border-[#CC310E] bg-[#CC310E] text-white" : "border-sky-200 bg-white text-slate-700 hover:border-[#CC310E]/50"}`}>
+                      {n}
+                    </button>
+                  ))}
+                </div>
+              </div>
+              {shape && (
+                <div role="status" className="rounded-2xl border border-sky-200 bg-white p-4">
+                  <p className="text-xl font-black text-slate-900">{shape.name}</p>
+                  <p className="mt-1 text-sm text-slate-600">Bond angles: {shape.angles}</p>
+                  <p className="text-sm text-slate-600">Example: <span className="font-bold text-slate-900">{shape.example}</span></p>
+                  {shape.lone > 0 && <p className="mt-2 text-xs text-slate-500">Lone pairs push harder than bonding pairs, so angles shrink.</p>}
+                </div>
+              )}
+            </>
+          ) : (
+            <>
+              <div className="rounded-2xl border border-sky-200 bg-white p-4">
+                <p className="text-sm text-slate-600">
+                  <span className="font-extrabold text-slate-900">{question.shape.bonded}</span> bonded atoms and{" "}
+                  <span className="font-extrabold text-slate-900">{question.shape.lone}</span> lone pair{question.shape.lone === 1 ? "" : "s"}. What is the shape?
+                </p>
+              </div>
+              <div className="grid grid-cols-1 gap-2 sm:grid-cols-2" role="group" aria-label="Answers">
+                {question.options.map((o) => {
+                  const correct = picked && o === question.shape.name;
+                  const wrong = picked === o && o !== question.shape.name;
+                  return (
+                    <button key={o} type="button" onClick={() => answer(o)} disabled={!!picked}
+                      className={`flex items-center justify-between gap-2 rounded-xl border px-3 py-3 text-left text-sm font-bold transition ${
+                        correct ? "border-sky-500 bg-sky-50 text-sky-900" : wrong ? "border-[#CC310E] bg-[#FEF3EF] text-[#A8270B]" : "border-sky-200 bg-white text-slate-700 hover:border-sky-400"
+                      }`}>
+                      {o}
+                      {correct && <CheckCircle2 className="h-4 w-4 shrink-0" />}
+                      {wrong && <XCircle className="h-4 w-4 shrink-0" />}
+                    </button>
+                  );
+                })}
+              </div>
+              {picked && (
+                <>
+                  <p role="status" className="text-sm text-slate-600">
+                    {picked === question.shape.name ? "Correct. " : `It's ${question.shape.name}. `}
+                    Example: {question.shape.example}, angles {question.shape.angles}.
+                  </p>
+                  <button type="button" onClick={() => { setPicked(null); setRound((r) => r + 1); }} className={primaryBtn}>Next question</button>
+                </>
+              )}
+              <button type="button" onClick={() => { setRound(0); setPicked(null); setScore(0); setAnswered(0); }} className={ghostBtn}>
+                <RotateCcw className="h-4 w-4" />
+                Restart quiz
+              </button>
+            </>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/landing/sims/PhScale.tsx b/frontend/src/components/landing/sims/PhScale.tsx
new file mode 100644
index 0000000..5a06e68
--- /dev/null
+++ b/frontend/src/components/landing/sims/PhScale.tsx
@@ -0,0 +1,119 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { RotateCcw } from "lucide-react";
+import { SUBSTANCES, guessPoints, hydrogenIon, phColor, phLabel, shuffled } from "@/lib/sim";
+import { Readout, ScoreBar, Slider, ghostBtn, primaryBtn } from "./SimUI";
+
+const ROUNDS = 5;
+const SUP = "⁰¹²³⁴⁵⁶⁷⁸⁹";
+const sup = (n: number) => `${n < 0 ? "⁻" : ""}${String(Math.abs(n)).split("").map((d) => SUP[Number(d)]).join("")}`;
+
+function concentration(ph: number) {
+  const { mantissa, exponent } = hydrogenIon(ph);
+  return `${mantissa.toFixed(1)} × 10${sup(exponent)} mol/L`;
+}
+
+function comparison(ph: number) {
+  const times = Math.pow(10, Math.abs(7 - ph));
+  const x = times >= 100 ? times.toExponential(0).replace("e+", " × 10^") : times.toFixed(times < 10 ? 1 : 0);
+  if (Math.abs(7 - ph) < 0.05) return "Same acidity as pure water.";
+  return `${x}× ${ph < 7 ? "more acidic" : "more basic"} than pure water.`;
+}
+
+export default function PhScale() {
+  const [plays, setPlays] = useState(1);
+  const [round, setRound] = useState(0);
+  const [guess, setGuess] = useState(7);
+  const [revealed, setRevealed] = useState(false);
+  const [score, setScore] = useState(0);
+
+  const picks = useMemo(() => shuffled(SUBSTANCES, plays).slice(0, ROUNDS), [plays]);
+  const current = picks[Math.min(round, ROUNDS - 1)];
+  const finished = round >= ROUNDS;
+  const points = revealed ? guessPoints(guess, current.ph) : 0;
+
+  const check = () => {
+    setRevealed(true);
+    setScore((s) => s + guessPoints(guess, current.ph));
+  };
+  const next = () => {
+    setRevealed(false);
+    setGuess(7);
+    setRound((r) => r + 1);
+  };
+  const again = () => {
+    setPlays((p) => p + 1);
+    setRound(0);
+    setScore(0);
+    setRevealed(false);
+    setGuess(7);
+  };
+
+  return (
+    <div className="space-y-5">
+      <ScoreBar items={[{ label: "Round", value: `${Math.min(round + 1, ROUNDS)}/${ROUNDS}` }, { label: "Score", value: `${score}/${ROUNDS * 3}` }]} />
+
+      {/* The scale */}
+      <div className="rounded-2xl border border-sky-200 bg-white p-4">
+        <svg viewBox="0 0 600 90" className="h-auto w-full" role="img" aria-label="pH scale from 0 to 14">
+          {Array.from({ length: 15 }, (_, i) => (
+            <g key={i}>
+              <rect x={30 + i * 36} y="30" width="36" height="22" style={{ fill: phColor(i) }} />
+              <text x={48 + i * 36} y="70" textAnchor="middle" fontSize="11" fill="#475569" fontFamily="var(--font-geist-mono)">{i}</text>
+            </g>
+          ))}
+          <text x="30" y="16" fontSize="11" fill="#64748B">Acidic</text>
+          <text x="570" y="16" fontSize="11" fill="#64748B" textAnchor="end">Basic</text>
+          {!finished && <path d={`M${48 + guess * 36} 28 l-7 -12 h14 z`} fill="#0F172A" />}
+          {revealed && <path d={`M${48 + current.ph * 36} 54 l-7 12 h14 z`} fill="#CC310E" />}
+        </svg>
+      </div>
+
+      {finished ? (
+        <div className="rounded-2xl border border-sky-200 bg-sky-50 p-6 text-center">
+          <p className="text-3xl font-black text-slate-900">{score} / {ROUNDS * 3}</p>
+          <p className="mt-1 text-slate-600">
+            {score >= 13 ? "Excellent. You have a real feel for pH." : score >= 8 ? "Solid. Review the extremes of the scale and try again." : "Good start. Remember lemon juice is about 2 and bleach is about 12.5."}
+          </p>
+          <button type="button" onClick={again} className={`${primaryBtn} mx-auto mt-4 max-w-xs`}>
+            <RotateCcw className="h-4 w-4" />
+            Play again
+          </button>
+        </div>
+      ) : (
+        <div className="grid gap-6 lg:grid-cols-[1fr_280px]">
+          <div className="space-y-3">
+            <p className="text-sm text-slate-600">Where does this fall on the pH scale?</p>
+            <p className="text-3xl font-black tracking-tight text-slate-900">{current.name}</p>
+            {revealed && (
+              <div role="status" className="rounded-2xl border border-sky-200 bg-white p-4 text-sm">
+                <p className="font-extrabold text-slate-900">
+                  Actual pH {current.ph} <span className="font-semibold text-slate-500">({phLabel(current.ph)})</span> · you scored {points}/3
+                </p>
+                <p className="mt-1 text-slate-600">[H⁺] = {concentration(current.ph)}. {comparison(current.ph)}</p>
+                <p className="mt-1 text-xs text-slate-500">Each pH step is a 10× change in hydrogen-ion concentration.</p>
+              </div>
+            )}
+          </div>
+          <div className="space-y-4">
+            <Slider label="Your guess" value={guess} min={0} max={14} step={0.1} unit="" onChange={(v) => !revealed && setGuess(Number(v.toFixed(1)))} tone="chemistry" />
+            <div className="grid grid-cols-2 gap-2">
+              <Readout label="Guess" value={`pH ${guess.toFixed(1)}`} />
+              <Readout label="[H⁺]" value={concentration(guess)} />
+            </div>
+            {revealed ? (
+              <button type="button" onClick={next} className={primaryBtn}>{round + 1 === ROUNDS ? "See results" : "Next substance"}</button>
+            ) : (
+              <button type="button" onClick={check} className={primaryBtn}>Check answer</button>
+            )}
+            <button type="button" onClick={again} className={ghostBtn}>
+              <RotateCcw className="h-4 w-4" />
+              Restart
+            </button>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/frontend/src/components/landing/sims/ProjectileGame.tsx b/frontend/src/components/landing/sims/ProjectileGame.tsx
new file mode 100644
index 0000000..c7fb84e
--- /dev/null
+++ b/frontend/src/components/landing/sims/ProjectileGame.tsx
@@ -0,0 +1,209 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import { Play, RotateCcw, Target } from "lucide-react";
+import {
+  GRAVITY,
+  MAX_LAUNCH_SPEED,
+  hitPoints,
+  positionAt,
+  projectile,
+  targetDistance,
+  targetTolerance,
+  trajectory,
+  type Planet,
+} from "@/lib/sim";
+import { Readout, ScoreBar, Slider, ghostBtn, primaryBtn } from "./SimUI";
+
+const W = 600;
+const H = 300;
+const GROUND = 262;
+const LEFT = 30;
+
+type Feedback = { kind: "idle" | "hit" | "miss"; text: string };
+
+export default function ProjectileGame() {
+  const [planet, setPlanet] = useState<Planet>("Earth");
+  const [level, setLevel] = useState(1);
+  const [speed, setSpeed] = useState(25);
+  const [angle, setAngle] = useState(40);
+  const [t, setT] = useState<number | null>(null);
+  const [flying, setFlying] = useState(false);
+  const [attempts, setAttempts] = useState(0);
+  const [score, setScore] = useState(0);
+  const [solved, setSolved] = useState(false);
+  const [lastShot, setLastShot] = useState<{ speed: number; angle: number } | null>(null);
+  const [feedback, setFeedback] = useState<Feedback>({
+    kind: "idle",
+    text: "Set speed and angle, then fire at the target.",
+  });
+  const raf = useRef<number | null>(null);
+
+  const g = GRAVITY[planet];
+  const target = targetDistance(level, g);
+  const tol = targetTolerance(target);
+  const xMax = target * 1.35;
+  const scale = (W - LEFT - 20) / xMax;
+  const px = (x: number) => LEFT + x * scale;
+  const py = (y: number) => GROUND - y * scale;
+
+  useEffect(
+    () => () => {
+      if (raf.current !== null) cancelAnimationFrame(raf.current);
+    },
+    [],
+  );
+
+  const resetRound = (nextLevel: number) => {
+    setLevel(nextLevel);
+    setAttempts(0);
+    setSolved(false);
+    setT(null);
+    setLastShot(null);
+    setFeedback({ kind: "idle", text: "New target. Set speed and angle, then fire." });
+  };
+
+  const changePlanet = (p: Planet) => {
+    setPlanet(p);
+    setAttempts(0);
+    setSolved(false);
+    setT(null);
+    setLastShot(null);
+    setFeedback({ kind: "idle", text: `Gravity is now ${GRAVITY[p]} m/s². The target moved, so aim again.` });
+  };
+
+  const fire = () => {
+    if (flying || solved) return;
+    const result = projectile(speed, angle, g);
+    const shotAttempts = attempts + 1;
+    setAttempts(shotAttempts);
+    setFlying(true);
+    setLastShot({ speed, angle });
+    const duration = Math.min(3.5, Math.max(1.2, result.flightTime));
+    const rate = result.flightTime / duration;
+    const start = performance.now();
+    const step = (now: number) => {
+      const sim = ((now - start) / 1000) * rate;
+      if (sim >= result.flightTime) {
+        setT(result.flightTime);
+        setFlying(false);
+        raf.current = null;
+        const miss = result.range - target;
+        if (Math.abs(miss) <= tol) {
+          const pts = hitPoints(shotAttempts);
+          setScore((s) => s + pts);
+          setSolved(true);
+          setFeedback({ kind: "hit", text: `Direct hit! +${pts} point${pts > 1 ? "s" : ""}.` });
+        } else {
+          setFeedback({
+            kind: "miss",
+            text: `${miss < 0 ? "Too short" : "Too far"} by ${Math.abs(miss).toFixed(1)} m. Adjust and try again.`,
+          });
+        }
+        return;
+      }
+      setT(sim);
+      raf.current = requestAnimationFrame(step);
+    };
+    raf.current = requestAnimationFrame(step);
+  };
+
+  const ball = t === null || !lastShot ? null : positionAt(lastShot.speed, lastShot.angle, g, t);
+  const ghost = lastShot
+    ? trajectory(lastShot.speed, lastShot.angle, g)
