--- /dev/null
+++ b/frontend/src/components/landing/SimulationsSection.tsx
@@ -0,0 +1,144 @@
+"use client";
+
+import dynamic from "next/dynamic";
+import { useEffect, useRef, useState, type ComponentType } from "react";
+import { AnimatePresence, motion } from "framer-motion";
+import { Atom, FlaskConical, Loader2, Magnet, Play, TestTube2, X, type LucideIcon } from "lucide-react";
+
+const Loading = () => (
+  <div className="flex h-64 items-center justify-center text-slate-500">
+    <Loader2 className="h-6 w-6 animate-spin" />
+  </div>
+);
+
+// Each game is its own chunk: nothing loads until a student launches it.
+const ProjectileGame = dynamic(() => import("./sims/ProjectileGame"), { ssr: false, loading: Loading });
+const BohrAtom = dynamic(() => import("./sims/BohrAtom"), { ssr: false, loading: Loading });
+const MoleculeShapes = dynamic(() => import("./sims/MoleculeShapes"), { ssr: false, loading: Loading });
+const PhScale = dynamic(() => import("./sims/PhScale"), { ssr: false, loading: Loading });
+
+interface Sim {
+  id: string;
+  icon: LucideIcon;
+  title: string;
+  text: string;
+  goal: string;
+  subject: "physics" | "chemistry";
+  Component: ComponentType;
+}
+
+const SIMS: Sim[] = [
+  { id: "projectile", icon: Magnet, title: "Projectile Motion", text: "Change angle and speed, watch the arc.", goal: "Hit moving-distance targets on Earth, Moon and Mars.", subject: "physics", Component: ProjectileGame },
+  { id: "bohr", icon: Atom, title: "Bohr Atom", text: "Excite electrons between energy levels.", goal: "Fire off real hydrogen spectral lines and finish 4 challenges.", subject: "physics", Component: BohrAtom },
+  { id: "molecule", icon: FlaskConical, title: "Molecule Shapes", text: "Build molecules and see bond angles.", goal: "Rotate 3D VSEPR shapes, then quiz yourself on all 13.", subject: "chemistry", Component: MoleculeShapes },
+  { id: "ph", icon: TestTube2, title: "pH Scale", text: "Mix solutions and read the colour.", goal: "Guess the pH of everyday liquids over 5 rounds.", subject: "chemistry", Component: PhScale },
+];
+
+function SimModal({ sim, onClose }: { sim: Sim; onClose: () => void }) {
+  const closeRef = useRef<HTMLButtonElement>(null);
+
+  useEffect(() => {
+    const opener = document.activeElement as HTMLElement | null;
+    const prevOverflow = document.body.style.overflow;
+    document.body.style.overflow = "hidden";
+    closeRef.current?.focus();
+    const onKey = (e: KeyboardEvent) => e.key === "Escape" && onClose();
+    window.addEventListener("keydown", onKey);
+    return () => {
+      window.removeEventListener("keydown", onKey);
+      document.body.style.overflow = prevOverflow;
+      opener?.focus();
+    };
+  }, [onClose]);
+
+  const physics = sim.subject === "physics";
+  return (
+    <motion.div
+      initial={{ opacity: 0 }}
+      animate={{ opacity: 1 }}
+      exit={{ opacity: 0 }}
+      className="fixed inset-0 z-[60] flex items-end justify-center bg-slate-900/50 p-0 backdrop-blur-sm sm:items-center sm:p-6"
+      onClick={onClose}
+    >
+      <motion.div
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="sim-title"
+        initial={{ y: 40, opacity: 0 }}
+        animate={{ y: 0, opacity: 1 }}
+        exit={{ y: 40, opacity: 0 }}
+        transition={{ type: "spring", stiffness: 300, damping: 30 }}
+        onClick={(e) => e.stopPropagation()}
+        className="flex max-h-[94vh] w-full max-w-4xl flex-col overflow-hidden rounded-t-3xl border border-sky-200 bg-[#F3F8FC] shadow-2xl sm:rounded-3xl"
+      >
+        <div className={`h-1.5 w-full ${physics ? "bg-sky-500" : "bg-[#CC310E]"}`} />
+        <div className="flex items-center justify-between gap-3 border-b border-sky-100 bg-white px-5 py-3">
+          <div className="flex items-center gap-3">
+            <span className={`flex h-9 w-9 items-center justify-center rounded-xl ${physics ? "bg-sky-100 text-sky-700" : "bg-[#CC310E]/10 text-[#CC310E]"}`}>
+              <sim.icon className="h-5 w-5" />
+            </span>
+            <div>
+              <h3 id="sim-title" className="font-extrabold text-slate-900">{sim.title}</h3>
+              <p className="text-xs text-slate-500">{sim.goal}</p>
+            </div>
+          </div>
+          <button ref={closeRef} type="button" onClick={onClose} aria-label="Close simulation" className="flex h-10 w-10 items-center justify-center rounded-full text-slate-600 hover:bg-sky-100">
+            <X className="h-5 w-5" />
+          </button>
+        </div>
+        <div className="overflow-y-auto p-4 sm:p-6">
+          <sim.Component />
+        </div>
+      </motion.div>
+    </motion.div>
+  );
+}
+
+export default function SimulationsSection() {
+  const [openId, setOpenId] = useState<string | null>(null);
+  const open = SIMS.find((s) => s.id === openId) ?? null;
+
+  return (
+    <section id="simulations" className="scroll-mt-20 bg-[#F3F8FC] px-4 py-20 sm:px-6">
+      <div className="mx-auto max-w-6xl">
+        <motion.div initial={{ opacity: 0, y: 24 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: "-80px" }} transition={{ duration: 0.5 }} className="mx-auto mb-10 max-w-2xl text-center">
+          <p className="text-xs font-bold uppercase tracking-widest text-[#CC310E]">Simulations</p>
+          <h2 className="mt-2 text-3xl font-black tracking-tight text-slate-900 sm:text-4xl">Learn by changing the variables</h2>
+          <p className="mt-3 text-slate-600">Four playable simulations. Pick one and launch it right here, no account needed.</p>
+        </motion.div>
+
+        <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
+          {SIMS.map((s, i) => {
+            const physics = s.subject === "physics";
+            return (
+              <motion.div
+                key={s.id}
+                initial={{ opacity: 0, y: 24 }}
+                whileInView={{ opacity: 1, y: 0 }}
+                viewport={{ once: true, margin: "-80px" }}
+                transition={{ duration: 0.5, delay: i * 0.07 }}
+                whileHover={{ y: -4 }}
+                className={`flex flex-col rounded-2xl border bg-white p-5 shadow-sm ${physics ? "border-sky-300/70" : "border-[#CC310E]/25"}`}
+              >
+                <s.icon className={`h-6 w-6 ${physics ? "text-sky-600" : "text-[#CC310E]"}`} />
+                <h3 className="mt-3 font-extrabold text-slate-900">{s.title}</h3>
+                <p className="mt-1 text-sm text-slate-600">{s.text}</p>
+                <p className="mt-2 flex-1 text-xs text-slate-500">{s.goal}</p>
+                <button
+                  type="button"
+                  onClick={() => setOpenId(s.id)}
+                  className="mt-4 inline-flex items-center justify-center gap-2 rounded-full bg-[#CC310E] px-4 py-2.5 text-sm font-extrabold text-white shadow-[0_8px_24px_-8px_rgba(204,49,14,0.7)] transition hover:bg-[#A8270B] active:scale-95"
+                >
+                  <Play className="h-4 w-4 fill-current" />
+                  Launch
+                </button>
+              </motion.div>
+            );
+          })}
+        </div>
+      </div>
+
+      <AnimatePresence>{open && <SimModal key={open.id} sim={open} onClose={() => setOpenId(null)} />}</AnimatePresence>
+    </section>
+  );
+}
diff --git a/frontend/src/components/landing/sims/BohrAtom.tsx b/frontend/src/components/landing/sims/BohrAtom.tsx
new file mode 100644
index 0000000..a2b90dc
--- /dev/null
+++ b/frontend/src/components/landing/sims/BohrAtom.tsx
@@ -0,0 +1,173 @@
+"use client";
+
+import { useState } from "react";
+import { motion } from "framer-motion";
+import { CheckCircle2, Circle, RotateCcw } from "lucide-react";
+import {
+  CHALLENGES,
+  MAX_LEVEL,
+  levelEnergy,
+  seriesName,
+  spectralRegion,
+  transitionEnergy,
+  wavelengthNm,
+  wavelengthToColor,
+  type Transition,
+} from "@/lib/sim-bohr";
+import { ScoreBar, ghostBtn } from "./SimUI";
+
+const C = 150;
+const radius = (n: number) => 22 + (n - 1) * 24; // compressed for display, not to scale
+
+interface Event extends Transition {
+  energy: number;
+  nm: number;
+  region: string;
+  series: string;
+  color: string | null;
+}
+
+const LEVELS = Array.from({ length: MAX_LEVEL }, (_, i) => i + 1);
+// Energy ladder geometry: -13.6 eV at the bottom, 0 at the top.
+const ladderY = (n: number) => 20 + (-levelEnergy(n) / 13.6) * 200;
+
+export default function BohrAtom() {
+  const [level, setLevel] = useState(1);
+  const [event, setEvent] = useState<Event | null>(null);
+  const [done, setDone] = useState<string[]>([]);
+  const [moves, setMoves] = useState(0);
+
+  const goTo = (n: number) => {
+    if (n === level) return;
+    const t: Transition = { type: n > level ? "absorb" : "emit", from: level, to: n };
+    const nm = wavelengthNm(level, n);
+    setEvent({
+      ...t,
+      energy: transitionEnergy(level, n),
+      nm,
+      region: spectralRegion(nm),
+      series: seriesName(level, n),
+      color: wavelengthToColor(nm),
+    });
+    setLevel(n);
+    setMoves((m) => m + 1);
+    setDone((d) => {
+      const fresh = CHALLENGES.filter((c) => c.done(t) && !d.includes(c.id)).map((c) => c.id);
+      return fresh.length ? [...d, ...fresh] : d;
+    });
+  };
+
+  const reset = () => {
+    setLevel(1);
+    setEvent(null);
+    setDone([]);
+    setMoves(0);
+  };
+
+  return (
+    <div className="space-y-5">
+      <ScoreBar items={[{ label: "Level", value: `n = ${level}` }, { label: "Jumps", value: moves }, { label: "Challenges", value: `${done.length}/${CHALLENGES.length}` }]} />
+
+      <div className="grid gap-6 lg:grid-cols-2">
+        {/* Atom */}
+        <div className="overflow-hidden rounded-2xl border border-sky-200 bg-gradient-to-b from-sky-50 to-white">
+          <svg viewBox="0 0 300 300" className="mx-auto block h-auto w-full max-w-sm" role="img" aria-label={`Hydrogen atom, electron at level ${level}`}>
+            {LEVELS.map((n) => (
+              <g key={n}>
+                <circle cx={C} cy={C} r={radius(n)} fill="none" stroke={n === level ? "#0284C7" : "#BAE6FD"} strokeWidth={n === level ? 2 : 1.2} strokeDasharray={n === level ? undefined : "3 4"} />
+                <circle cx={C} cy={C} r={radius(n)} fill="none" stroke="transparent" strokeWidth="14" className="cursor-pointer" onClick={() => goTo(n)} />
+                <text x={C + radius(n) * 0.707 + 3} y={C - radius(n) * 0.707 - 3} fontSize="10" fill="#64748B" fontFamily="var(--font-geist-mono)">
+                  {n}
+                </text>
+              </g>
+            ))}
+            <circle cx={C} cy={C} r="10" fill="#CC310E" />
+            <text x={C} y={C + 3.5} textAnchor="middle" fontSize="9" fontWeight="700" fill="white">p⁺</text>
+            <g className="azs-spin" style={{ transformOrigin: `${C}px ${C}px`, animation: `azs-spin ${1.4 * Math.pow(level, 1.5)}s linear infinite` }}>
+              <motion.circle initial={false} animate={{ cx: C + radius(level) }} cy={C} r="7" fill="#0369A1" transition={{ type: "spring", stiffness: 140, damping: 18 }} />
+            </g>
+          </svg>
+          <div className="flex flex-wrap justify-center gap-2 px-3 pb-4" role="group" aria-label="Move electron to level">
+            {LEVELS.map((n) => (
+              <button
+                key={n}
+                type="button"
+                onClick={() => goTo(n)}
+                aria-pressed={n === level}
+                aria-label={`Move electron to level ${n}`}
+                className={`h-10 w-10 rounded-full border text-sm font-extrabold transition ${
+                  n === level ? "border-sky-600 bg-sky-600 text-white" : "border-sky-200 bg-white text-slate-700 hover:border-sky-400"
+                }`}
+              >
+                {n}
+              </button>
+            ))}
+          </div>
+        </div>
+
+        {/* Readout, ladder, challenges */}
+        <div className="space-y-4">
+          <div role="status" className="rounded-2xl border border-sky-200 bg-white p-4">
+            {event ? (
+              <div className="flex items-start gap-3">
+                <span
+                  className="mt-0.5 h-10 w-10 shrink-0 rounded-full border border-slate-300"
+                  style={event.color ? { background: event.color, boxShadow: `0 0 18px ${event.color}` } : { background: "repeating-linear-gradient(45deg,#E2E8F0,#E2E8F0 4px,#F8FAFC 4px,#F8FAFC 8px)" }}
+                  aria-hidden="true"
+                />
+                <div className="text-sm">
+                  <p className="font-extrabold text-slate-900">
+                    {event.type === "absorb" ? "Photon absorbed" : "Photon emitted"}: n = {event.from} → {event.to}
+                  </p>
+                  <p className="mt-0.5 text-slate-600">
+                    {event.energy.toFixed(2)} eV · {event.nm.toFixed(1)} nm · {event.region}
+                    {event.region !== "Visible" && " (invisible to the eye)"}
+                  </p>
+                  <p className="text-xs text-slate-500">{event.series} series</p>
+                </div>
+              </div>
+            ) : (
+              <p className="text-sm text-slate-600">Click an orbit or a number to move the electron. Jumping up absorbs a photon, falling down emits one.</p>
+            )}
+          </div>
+
+          <div className="rounded-2xl border border-sky-200 bg-white p-3">
+            <p className="mb-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">Energy levels (eV)</p>
+            <svg viewBox="0 0 260 235" className="h-auto w-full" aria-hidden="true">
+              {LEVELS.map((n) => (
+                <g key={n}>
+                  <line x1="50" x2="200" y1={ladderY(n)} y2={ladderY(n)} stroke={n === level ? "#0284C7" : "#CBD5E1"} strokeWidth={n === level ? 3 : 1.5} />
+                  <text x="44" y={ladderY(n) + 3.5} textAnchor="end" fontSize="10" fill="#475569" fontFamily="var(--font-geist-mono)">n={n}</text>
+                  <text x="206" y={ladderY(n) + 3.5} fontSize="10" fill="#64748B" fontFamily="var(--font-geist-mono)">{levelEnergy(n).toFixed(2)}</text>
+                </g>
+              ))}
+              {event && (
+                <line x1="125" x2="125" y1={ladderY(event.from)} y2={ladderY(event.to)} stroke={event.color ?? "#94A3B8"} strokeWidth="4" strokeDasharray={event.color ? undefined : "4 4"} strokeLinecap="round" />
+              )}
+              <circle cx="125" cy={ladderY(level)} r="6" fill="#0369A1" />
+            </svg>
+          </div>
+
+          <ul className="space-y-1.5" aria-label="Challenges">
+            {CHALLENGES.map((c) => {
+              const ok = done.includes(c.id);
+              return (
+                <li key={c.id} className={`flex items-center gap-2 text-sm ${ok ? "font-bold text-sky-800" : "text-slate-600"}`}>
+                  {ok ? <CheckCircle2 className="h-4 w-4 shrink-0 text-sky-600" /> : <Circle className="h-4 w-4 shrink-0 text-slate-300" />}
+                  {c.text}
+                </li>
+              );
+            })}
+          </ul>
+          {done.length === CHALLENGES.length && (
+            <p className="rounded-xl border border-sky-300 bg-sky-50 px-3 py-2 text-sm font-bold text-sky-900">All challenges complete. You&apos;ve mapped the hydrogen spectrum.</p>
+          )}
+          <button type="button" onClick={reset} className={ghostBtn}>
+            <RotateCcw className="h-4 w-4" />
+            Reset atom
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/frontend/src/components/landing/sims/MoleculeShapes.tsx b/frontend/src/components/landing/sims/MoleculeShapes.tsx
new file mode 100644
