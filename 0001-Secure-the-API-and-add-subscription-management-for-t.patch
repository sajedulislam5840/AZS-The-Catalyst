+from datetime import datetime
+from typing import List
+
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel
+from sqlalchemy import func, select, update
+from sqlalchemy.ext.asyncio import AsyncSession
+
+import uuid
+
+from app.core.access import get_current_user
+from app.core.database import get_db
+from app.models.billing import Notification
+from app.models.user import User
+from app.services.subscription import ensure_expiry_notifications, list_notifications
+
+router = APIRouter(prefix="/notifications", tags=["Notifications"])
+
+
+class NotificationOut(BaseModel):
+    id: str
+    kind: str
+    title: str
+    body: str
+    created_at: str
+    read: bool
+
+
+class NotificationsOut(BaseModel):
+    unread: int
+    items: List[NotificationOut]
+
+
+def _out(n: Notification) -> NotificationOut:
+    return NotificationOut(
+        id=str(n.id), kind=n.kind, title=n.title, body=n.body, created_at=n.created_at.isoformat() + "Z", read=n.read_at is not None
+    )
+
+
+@router.get("/me", response_model=NotificationsOut)
+async def my_notifications(user: User = Depends(get_current_user), db: AsyncSession = Depends(get_db)):
+    """The student's messages. Expiry warnings (7, 3 and 1 days left) are created here the first time they are due."""
+    await ensure_expiry_notifications(db, user)
+    items = await list_notifications(db, user)
+    unread = (
+        await db.execute(
+            select(func.count(Notification.id)).where(Notification.user_id == user.id, Notification.read_at.is_(None))
+        )
+    ).scalar_one()
+    return NotificationsOut(unread=int(unread or 0), items=[_out(n) for n in items])
+
+
+@router.post("/read-all")
+async def mark_all_read(user: User = Depends(get_current_user), db: AsyncSession = Depends(get_db)):
+    await db.execute(
+        update(Notification)
+        .where(Notification.user_id == user.id, Notification.read_at.is_(None))
+        .values(read_at=datetime.utcnow())
+    )
+    await db.commit()
+    return {"message": "ok"}
+
+
+@router.post("/{notification_id}/read")
+async def mark_read(notification_id: str, user: User = Depends(get_current_user), db: AsyncSession = Depends(get_db)):
+    try:
+        nid = uuid.UUID(notification_id)
+    except ValueError:
+        raise HTTPException(status_code=400, detail="Invalid notification id.")
+    await db.execute(
+        update(Notification)
+        .where(Notification.id == nid, Notification.user_id == user.id, Notification.read_at.is_(None))
+        .values(read_at=datetime.utcnow())
+    )
+    await db.commit()
+    return {"message": "ok"}
diff --git a/backend/app/core/access.py b/backend/app/core/access.py
new file mode 100644
index 0000000..2b115b9
--- /dev/null
+++ b/backend/app/core/access.py
@@ -0,0 +1,118 @@
+"""Who is logged in, who is the admin, and who has paid. Every protected route uses these.
+
+There is no fallback identity: no valid token means no access.
+"""
+from datetime import datetime
+from typing import Optional
+
+from fastapi import Depends, Header, HTTPException, status
+from jose import JWTError, jwt
+from sqlalchemy import func, select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.core.config import ADMIN_EMAIL, ALGORITHM, SECRET_KEY
+from app.core.database import get_db
+from app.models.user import User
+
+EXPIRING_DAYS = 7  # students are warned and flagged when this many days (or fewer) are left
+
+
+# ---------- who is the admin ----------
+
+def is_admin_user(user: User) -> bool:
+    return bool(
+        getattr(user, "is_admin", False)
+        or str(getattr(user, "role", "")).upper().endswith("ADMIN")
+        or (user.email or "").strip().lower() == ADMIN_EMAIL
+    )
+
+
+# ---------- subscription state ----------
+
+def days_left(user: User, now: Optional[datetime] = None) -> int:
+    now = now or datetime.utcnow()
+    end = user.subscription_end_date
+    if end and end > now:
+        return (end - now).days + 1
+    return 0
+
+
+def subscription_status(user: User, now: Optional[datetime] = None) -> str:
+    """active | expiring (7 days or fewer) | expired (paid before, lapsed) | pending (never paid / revoked)."""
+    now = now or datetime.utcnow()
+    if not user.is_approved or not user.subscription_end_date:
+        return "pending"
+    if user.subscription_end_date <= now:
+        return "expired"
+    return "expiring" if days_left(user, now) <= EXPIRING_DAYS else "active"
+
+
+def has_access(user: User, now: Optional[datetime] = None) -> bool:
+    if is_admin_user(user):
+        return True
+    return subscription_status(user, now) in ("active", "expiring")
+
+
+# ---------- token -> user ----------
+
+def _unauthorized(message: str) -> HTTPException:
+    return HTTPException(
+        status_code=status.HTTP_401_UNAUTHORIZED,
+        detail=message,
+        headers={"WWW-Authenticate": "Bearer"},
+    )
+
+
+async def _user_from_header(authorization: Optional[str], db: AsyncSession) -> User:
+    if not authorization or not authorization.startswith("Bearer "):
+        raise _unauthorized("Authentication token required.")
+    token = authorization.split(" ", 1)[1].strip()
+    try:
+        payload = jwt.decode(token, SECRET_KEY, algorithms=[ALGORITHM])  # expiry is enforced
+    except JWTError:
+        raise _unauthorized("Token invalid or expired.")
+    email = str(payload.get("sub") or "").strip().lower()
+    if not email:
+        raise _unauthorized("Invalid token identity.")
+    res = await db.execute(select(User).where(func.lower(User.email) == email))
+    user = res.scalar_one_or_none()
+    if user is None or user.is_active is False:
+        raise _unauthorized("User account not found.")
+    return user
+
+
+async def get_current_user(
+    authorization: Optional[str] = Header(None),
+    db: AsyncSession = Depends(get_db),
+) -> User:
+    return await _user_from_header(authorization, db)
+
+
+async def get_optional_user(
+    authorization: Optional[str] = Header(None),
+    db: AsyncSession = Depends(get_db),
+) -> Optional[User]:
+    try:
+        return await _user_from_header(authorization, db)
+    except HTTPException:
+        return None
+
+
+async def require_admin(user: User = Depends(get_current_user)) -> User:
+    if not is_admin_user(user):
+        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="Instructor/Admin privileges required.")
+    return user
+
+
+async def require_subscriber(user: User = Depends(get_current_user)) -> User:
+    """Admins, and students whose subscription is running. Everyone else is told why."""
+    if has_access(user):
+        return user
+    state = subscription_status(user)
+    raise HTTPException(
+        status_code=status.HTTP_403_FORBIDDEN,
+        detail={
+            "code": "subscription_expired" if state == "expired" else "subscription_required",
+            "message": "তোমার সাবস্ক্রিপশন সক্রিয় নেই। রিনিউ করতে শিক্ষকের সাথে যোগাযোগ করো।",
+        },
+    )
diff --git a/backend/app/core/config.py b/backend/app/core/config.py
new file mode 100644
index 0000000..93fae60
--- /dev/null
+++ b/backend/app/core/config.py
@@ -0,0 +1,40 @@
+"""Settings that decide who is trusted. Read from the environment, never hard-coded.
+
+SECRET_KEY    Signs login tokens. Set it on Render to a long random string.
+              If it is missing, a key is derived from DATABASE_URL (a secret that is not in the repo),
+              so tokens are still unforgeable and survive restarts. A warning is logged.
+ADMIN_EMAIL   The one admin account (default rabbi@edutrack.com).
+"""
+import hashlib
+import logging
+import os
+import secrets
+
+log = logging.getLogger("azs.config")
+
+ALGORITHM = "HS256"
+ADMIN_EMAIL = (os.getenv("ADMIN_EMAIL") or "rabbi@edutrack.com").strip().lower()
+
+# Values that were once published in the public repository. They must never be trusted.
+_PUBLISHED_KEYS = {
+    "edutrack-super-secret-jwt-key-2025",
+    "edutrack_academic_secret_jwt_key_2026",
+}
+
+
+def _load_secret_key() -> str:
+    key = (os.getenv("SECRET_KEY") or "").strip()
+    if key and key not in _PUBLISHED_KEYS and len(key) >= 16:
+        return key
+
+    reason = "is not set" if not key else "is a value that was published in the repository, or is too short"
+    db_url = (os.getenv("DATABASE_URL") or "").strip()
+    if db_url:
+        log.warning("SECRET_KEY %s. Using a key derived from DATABASE_URL. Set SECRET_KEY on Render.", reason)
+        return hashlib.sha256(("azs-jwt-v1|" + db_url).encode("utf-8")).hexdigest()
+
+    log.warning("SECRET_KEY %s and DATABASE_URL is empty. Using a random key; logins reset on every restart.", reason)
+    return secrets.token_hex(32)
+
+
+SECRET_KEY = _load_secret_key()
