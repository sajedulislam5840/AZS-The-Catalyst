+            <line x1={LEFT} y1={GROUND} x2={W - 6} y2={GROUND} stroke="#94A3B8" strokeWidth="2" />
+            {/* target zone */}
+            <rect x={px(target - tol)} y={GROUND - 6} width={Math.max(6, 2 * tol * scale)} height="6" fill="#CC310E" opacity="0.9" />
