+/** Link helpers for lecture videos and PDF previews. */
+
+export function getYouTubeId(url: string): string | null {
+  if (!url) return null;
+  const u = url.trim();
+  try {
+    if (u.includes("youtu.be/")) return u.split("youtu.be/")[1]?.split(/[?&#]/)[0] || null;
+    if (u.includes("youtube.com/watch")) return new URLSearchParams(u.split("?")[1]?.split("#")[0] ?? "").get("v") || null;
+    for (const part of ["youtube.com/embed/", "youtube.com/shorts/", "youtube.com/live/"]) {
+      if (u.includes(part)) return u.split(part)[1]?.split(/[?&#]/)[0] || null;
+    }
+    if (/^[\w-]{11}$/.test(u)) return u;
+  } catch {
+    return null;
+  }
+  return null;
+}
+
+/** Embed URL for a YouTube link; any other link is returned unchanged. */
+export function getYouTubeEmbedUrl(url: string, startAt = 0, autoplay = false): string {
+  const id = getYouTubeId(url);
+  if (!id) return url?.trim() ?? "";
+  const q = new URLSearchParams({ rel: "0", playsinline: "1" });
+  if (startAt > 0) q.set("start", String(Math.floor(startAt)));
+  if (autoplay) q.set("autoplay", "1");
+  return `https://www.youtube.com/embed/${id}?${q.toString()}`;
+}
+
+export function getYouTubeThumb(url: string): string | null {
+  const id = getYouTubeId(url);
+  return id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : null;
+}
+
+export function getDrivePreviewUrl(url: string): string {
+  if (!url) return "";
+  const file = url.match(/drive\.google\.com\/file\/d\/([\w-]+)/);
+  if (file) return `https://drive.google.com/file/d/${file[1]}/preview`;
+  if (url.includes("drive.google.com/open?id=")) {
+    const id = url.split("id=")[1]?.split("&")[0];
+    if (id) return `https://drive.google.com/file/d/${id}/preview`;
+  }
+  return url;
+}
diff --git a/frontend/src/lib/progress-sync.ts b/frontend/src/lib/progress-sync.ts
new file mode 100644
index 0000000..c1e2971
--- /dev/null
+++ b/frontend/src/lib/progress-sync.ts
@@ -0,0 +1,268 @@
+/**
+ * Offline-safe progress writes.
+ *
+ * Every change is described as an Op. An Op is applied to the on-screen state straight away
+ * (optimistic update) and queued in an outbox saved in localStorage. The outbox is flushed to the
+ * server when possible; if the phone is offline the ops simply wait and are sent later.
+ * All server endpoints are idempotent, so a replayed op can never corrupt anything.
+ */
+import { EMPTY_STATE, isDayKey, type LectureProgress, type Plan, type ProgressState } from "./progress";
+
+export type Op =
+  | { type: "lecture"; id: string; body: { completed?: boolean; position?: number; duration?: number; day?: string } }
+  | { type: "note"; id: string; content: string; day?: string }
+  | { type: "plan-add"; plan: Plan }
+  | { type: "plan-del"; id: string };
+
+export interface Request {
+  method: "PUT" | "POST" | "DELETE";
+  url: string;
+  body?: Record<string, unknown>;
+}
+
+const BASE = "/api/v1/progress";
+
+export function opKey(op: Op): string {
+  switch (op.type) {
+    case "lecture":
+      return `lec:${op.id}`;
+    case "note":
+      return `note:${op.id}`;
+    default:
+      return `plan:${op.type === "plan-add" ? op.plan.id : op.id}`;
+  }
+}
+
+export function opToRequest(op: Op): Request {
+  switch (op.type) {
+    case "lecture":
+      return { method: "PUT", url: `${BASE}/lectures/${encodeURIComponent(op.id)}`, body: op.body };
+    case "note":
+      return { method: "PUT", url: `${BASE}/notes/${encodeURIComponent(op.id)}`, body: { content: op.content, day: op.day } };
+    case "plan-add":
+      return {
+        method: "POST",
+        url: `${BASE}/plans`,
+        body: {
+          id: op.plan.id,
+          date_key: op.plan.dateKey,
+          title: op.plan.title,
+          time: op.plan.time ?? null,
+          source: op.plan.source ?? "manual",
+        },
+      };
+    default:
+      return { method: "DELETE", url: `${BASE}/plans/${encodeURIComponent(op.id)}` };
+  }
+}
+
+/* ------------------------- optimistic reducer ------------------------- */
+
+function withDay(days: string[], day?: string): string[] {
+  if (!day || !isDayKey(day) || days.includes(day)) return days;
+  return [...days, day].sort();
+}
+
+export function applyOp(state: ProgressState, op: Op, nowIso: string): ProgressState {
+  switch (op.type) {
+    case "lecture": {
+      const prev: LectureProgress = state.lectures[op.id] ?? {
+        lecture_id: op.id,
+        completed: false,
+        completed_at: null,
+        position: 0,
+        duration: 0,
+        updated_at: nowIso,
+      };
+      const next: LectureProgress = { ...prev, updated_at: nowIso };
+      if (op.body.completed !== undefined) {
+        next.completed_at = op.body.completed ? (prev.completed ? prev.completed_at : nowIso) : null;
+        next.completed = op.body.completed;
+      }
+      if (op.body.position !== undefined) next.position = Math.max(0, Math.floor(op.body.position));
+      if (op.body.duration !== undefined) next.duration = Math.max(0, Math.floor(op.body.duration));
+      return { ...state, lectures: { ...state.lectures, [op.id]: next }, days: withDay(state.days, op.body.day) };
+    }
+    case "note":
+      return { ...state, notes: { ...state.notes, [op.id]: op.content }, days: withDay(state.days, op.day) };
+    case "plan-add": {
+      const others = state.plans.filter((p) => p.id !== op.plan.id);
+      return { ...state, plans: [...others, op.plan].sort((a, b) => a.dateKey.localeCompare(b.dateKey)) };
+    }
+    default:
+      return { ...state, plans: state.plans.filter((p) => p.id !== op.id) };
+  }
+}
+
+/* ------------------------- server snapshot ------------------------- */
+
+interface ServerSnapshot {
+  lectures?: LectureProgress[];
+  notes?: Record<string, { content: string }>;
+  plans?: { id: string; date_key: string; title: string; time?: string | null; source?: string }[];
+  activity_days?: string[];
+}
+
+export function fromServer(data: ServerSnapshot | null | undefined): ProgressState {
+  if (!data) return EMPTY_STATE;
+  const lectures: Record<string, LectureProgress> = {};
+  for (const l of data.lectures ?? []) lectures[l.lecture_id] = l;
+  const notes: Record<string, string> = {};
+  for (const [id, n] of Object.entries(data.notes ?? {})) notes[id] = n.content;
+  const plans: Plan[] = (data.plans ?? []).map((p) => ({
+    id: p.id,
+    dateKey: p.date_key,
+    title: p.title,
+    time: p.time ?? undefined,
+    source: p.source === "auto" ? "auto" : "manual",
+  }));
+  return { lectures, notes, plans, days: (data.activity_days ?? []).filter(isDayKey) };
+}
+
+/** Server state with any still-unsent local changes laid back on top. */
+export function overlayPending(server: ProgressState, pending: Op[], nowIso: string): ProgressState {
+  return pending.reduce((acc, op) => applyOp(acc, op, nowIso), server);
+}
+
+/* ------------------------- legacy browser data ------------------------- */
+
+export interface LegacyData {
+  watched: string[];
+  notes: Record<string, string>;
+  plans: Plan[];
+}
+
+export function readLegacy(storage: Pick<Storage, "getItem">): LegacyData {
+  const parse = <T,>(key: string, fallback: T): T => {
+    try {
+      const raw = storage.getItem(key);
+      return raw ? (JSON.parse(raw) as T) : fallback;
+    } catch {
+      return fallback;
+    }
+  };
+  const watched = parse<unknown>("edutrack_watched_videos", []);
+  const notes = parse<unknown>("edutrack_lecture_notes", {});
+  const plans = parse<unknown>("edutrack_study_plans", []);
+  return {
+    watched: Array.isArray(watched) ? watched.filter((x): x is string => typeof x === "string") : [],
+    notes:
+      notes && typeof notes === "object" && !Array.isArray(notes)
+        ? Object.fromEntries(Object.entries(notes as Record<string, unknown>).filter(([, v]) => typeof v === "string")) as Record<string, string>
+        : {},
+    plans: Array.isArray(plans)
+      ? (plans as Plan[]).filter((p) => p && typeof p.id === "string" && isDayKey(p.dateKey) && typeof p.title === "string")
+      : [],
+  };
+}
+
+export const hasLegacy = (l: LegacyData) =>
+  l.watched.length > 0 || Object.values(l.notes).some((n) => n.trim()) || l.plans.length > 0;
+
+/* ------------------------- outbox ------------------------- */
+
+type KV = Pick<Storage, "getItem" | "setItem">;
+export type Sender = (req: Request) => Promise<void>;
+
+/** HTTP status carried by an error, if any (axios puts it on error.response.status). */
+function statusOf(err: unknown): number | undefined {
+  const e = err as { response?: { status?: number }; status?: number };
+  return e?.response?.status ?? e?.status;
+}
+
+export class Outbox {
+  private ops: Op[];
+  private flushing: Promise<void> | null = null;
+  private again = false;
+
+  constructor(
+    private readonly storage: KV,
+    private readonly storageKey: string,
+    private readonly send: Sender,
+  ) {
+    this.ops = this.load();
+  }
+
+  private load(): Op[] {
+    try {
+      const raw = this.storage.getItem(this.storageKey);
+      const parsed = raw ? JSON.parse(raw) : [];
+      return Array.isArray(parsed) ? (parsed as Op[]) : [];
+    } catch {
+      return [];
+    }
+  }
+
+  private save() {
+    try {
+      this.storage.setItem(this.storageKey, JSON.stringify(this.ops));
+    } catch {
+      // Storage full or blocked: ops stay in memory for this session.
+    }
+  }
+
+  pending(): Op[] {
+    return [...this.ops];
+  }
+
+  size(): number {
+    return this.ops.length;
+  }
+
+  /** Queue an op. A newer op on the same thing replaces (or merges into) the older one. */
+  enqueue(op: Op): void {
+    const key = opKey(op);
+    const i = this.ops.findIndex((o) => opKey(o) === key);
+    if (i === -1) {
+      this.ops.push(op);
+    } else {
+      const old = this.ops[i];
+      if (old.type === "lecture" && op.type === "lecture") {
+        this.ops[i] = { ...op, body: { ...old.body, ...op.body } };
+      } else {
+        this.ops[i] = op;
+      }
+    }
+    this.save();
+  }
+
+  /**
+   * Send everything queued, in order. Stops at the first network or server failure and keeps the
+   * rest for next time. A rejected request (a 4xx that is not auth, rate-limit or missing-route) can never succeed, so it
+   * is dropped instead of blocking the queue forever.
+   */
+  flush(): Promise<void> {
+    if (this.flushing) {
+      this.again = true;
+      return this.flushing;
+    }
+    this.flushing = (async () => {
+      do {
+        this.again = false;
+        while (this.ops.length > 0) {
+          const op = this.ops[0];
+          try {
+            await this.send(opToRequest(op));
+          } catch (err) {
+            const status = statusOf(err);
+            // 404/405 count as temporary: it just means the server has not been updated with these routes yet.
+            const permanent = status !== undefined && status >= 400 && status < 500 && ![401, 404, 405, 408, 425, 429].includes(status);
+            if (!permanent) return;
+          }
+          // A newer op may have replaced this one while it was in flight: only drop what we sent.
+          if (this.ops[0] === op) this.ops.shift();
+          else this.ops = this.ops.filter((o) => o !== op);
+          this.save();
+        }
+      } while (this.again);
+    })().finally(() => {
+      this.flushing = null;
+    });
+    return this.flushing;
+  }
+
+  clear(): void {
+    this.ops = [];
+    this.save();
+  }
+}
diff --git a/frontend/src/lib/progress.ts b/frontend/src/lib/progress.ts
new file mode 100644
index 0000000..1786f81
--- /dev/null
+++ b/frontend/src/lib/progress.ts
@@ -0,0 +1,322 @@
+/**
+ * Pure student-progress logic. No React, no network, no clock access:
+ * everything takes "today" as an argument so it is deterministic and unit-testable.
+ */
+
+export interface LectureLite {
+  id: string;
+  chapter: string;
+  subject: string;
+  lecture_no: number;
+  topic?: string;
+  title?: string;
+}
+
+export interface LectureProgress {
+  lecture_id: string;
+  completed: boolean;
+  completed_at: string | null;
+  position: number;
+  duration: number;
+  updated_at: string;
+}
+
+export interface Plan {
+  id: string;
+  dateKey: string;
+  title: string;
+  time?: string;
+  source?: "manual" | "auto";
+}
+
+export interface ProgressState {
+  lectures: Record<string, LectureProgress>;
+  notes: Record<string, string>;
+  plans: Plan[];
+  days: string[];
+}
+
+export const EMPTY_STATE: ProgressState = { lectures: {}, notes: {}, plans: [], days: [] };
+
+/* ------------------------------ dates ------------------------------ */
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+/** YYYY-MM-DD in the student's own timezone. */
+export function dayKey(d: Date): string {
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+function toUtcMs(key: string): number {
+  const [y, m, d] = key.split("-").map(Number);
+  return Date.UTC(y, m - 1, d);
+}
+
+/** Calendar-day arithmetic that ignores daylight-saving shifts. */
+export function addDays(key: string, n: number): string {
+  const d = new Date(toUtcMs(key) + n * 86_400_000);
+  return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
+}
+
+export function dayDiff(later: string, earlier: string): number {
+  return Math.round((toUtcMs(later) - toUtcMs(earlier)) / 86_400_000);
+}
+
+export function isDayKey(value: unknown): value is string {
+  return typeof value === "string" && /^\d{4}-\d{2}-\d{2}$/.test(value);
+}
+
+/* ------------------------------ streaks ------------------------------ */
+
+export interface Streak {
+  current: number;
+  best: number;
+  activeToday: boolean;
+}
+
+/**
+ * The current streak stays alive until the end of the day after the last active day,
+ * so a student who has not studied yet today still sees yesterday's streak.
+ */
+export function computeStreak(days: string[], today: string): Streak {
+  const set = new Set(days.filter(isDayKey));
+  const activeToday = set.has(today);
+
+  let current = 0;
+  let cursor = activeToday ? today : addDays(today, -1);
+  while (set.has(cursor)) {
+    current += 1;
+    cursor = addDays(cursor, -1);
+  }
+
+  const sorted = [...set].sort();
+  let best = 0;
+  let run = 0;
+  for (let i = 0; i < sorted.length; i += 1) {
+    run = i > 0 && dayDiff(sorted[i], sorted[i - 1]) === 1 ? run + 1 : 1;
+    if (run > best) best = run;
+  }
+  return { current, best, activeToday };
+}
+
+export interface WeekDot {
+  day: string;
+  active: boolean;
+  isToday: boolean;
+}
+
+/** The last seven days, oldest first, ending today. */
+export function weekDots(days: string[], today: string): WeekDot[] {
+  const set = new Set(days);
+  return Array.from({ length: 7 }, (_, i) => {
+    const day = addDays(today, i - 6);
+    return { day, active: set.has(day), isToday: day === today };
+  });
+}
+
+/* ------------------------------ xp & level ------------------------------ */
+
+export const XP_PER_LECTURE = 20;
+export const XP_PER_NOTE = 5;
+export const XP_PER_ACTIVE_DAY = 3;
+
+export function computeXp(completed: number, notes: number, activeDays: number): number {
+  return completed * XP_PER_LECTURE + notes * XP_PER_NOTE + activeDays * XP_PER_ACTIVE_DAY;
+}
+
+export interface LevelInfo {
+  level: number;
+  xp: number;
+  intoLevel: number;
+  toNext: number;
+  pct: number;
+}
+
+/** Level L starts at 50 * (L - 1)^2 XP: 0, 50, 200, 450, 800 ... */
+export function levelInfo(xp: number): LevelInfo {
+  const safe = Math.max(0, Math.floor(xp));
+  const level = Math.floor(Math.sqrt(safe / 50)) + 1;
+  const start = 50 * (level - 1) ** 2;
+  const next = 50 * level ** 2;
+  const span = next - start;
+  const intoLevel = safe - start;
+  return { level, xp: safe, intoLevel, toNext: next - safe, pct: span > 0 ? Math.min(100, Math.round((intoLevel / span) * 100)) : 0 };
+}
+
+/* ------------------------------ stats ------------------------------ */
+
+export interface ChapterStat {
+  chapter: string;
+  subject: string;
+  total: number;
+  done: number;
+  pct: number;
+}
+
+export function chapterStats(lectures: LectureLite[], state: ProgressState): ChapterStat[] {
+  const map = new Map<string, ChapterStat>();
+  for (const l of lectures) {
+    const chapter = (l.chapter || "General Chapter").trim();
+    const key = `${(l.subject || "PHYSICS").toUpperCase()}::${chapter}`;
+    let stat = map.get(key);
+    if (!stat) {
+      stat = { chapter, subject: (l.subject || "PHYSICS").toUpperCase(), total: 0, done: 0, pct: 0 };
+      map.set(key, stat);
+    }
+    stat.total += 1;
+    if (state.lectures[l.id]?.completed) stat.done += 1;
+  }
+  return [...map.values()].map((s) => ({ ...s, pct: s.total ? Math.round((s.done / s.total) * 100) : 0 }));
+}
+
+export function countCompleted(lectures: LectureLite[], state: ProgressState): number {
+  let n = 0;
+  for (const l of lectures) if (state.lectures[l.id]?.completed) n += 1;
+  return n;
+}
+
+export function countNotes(state: ProgressState): number {
+  return Object.values(state.notes).filter((t) => t.trim().length > 0).length;
+}
+
+/** Lectures completed in the seven days ending today (by the student's local calendar). */
+export function completedThisWeek(state: ProgressState, today: string): number {
+  const from = addDays(today, -6);
+  let n = 0;
+  for (const p of Object.values(state.lectures)) {
+    if (!p.completed || !p.completed_at) continue;
+    const t = new Date(p.completed_at);
+    if (Number.isNaN(t.getTime())) continue;
+    const k = dayKey(t);
+    if (k >= from && k <= today) n += 1;
+  }
+  return n;
+}
+
+/* ------------------------------ resume ------------------------------ */
+
+export type ResumeKind = "resume" | "next" | "start" | "done";
+
+export interface Resume {
+  kind: ResumeKind;
+  lecture: LectureLite | null;
+  position: number;
+}
+
+/**
+ * What should the student watch next?
+ *  1. a lecture they started but did not finish (most recently touched first)
+ *  2. the next unfinished lecture in the chapter they most recently completed
+ *  3. the first unfinished lecture
+ */
+export function findResume(lectures: LectureLite[], state: ProgressState): Resume {
+  if (lectures.length === 0) return { kind: "done", lecture: null, position: 0 };
+
+  const touched = lectures
+    .map((l) => ({ l, p: state.lectures[l.id] }))
+    .filter(({ p }) => p && !p.completed && (p.position > 0 || p.updated_at))
+    .sort((a, b) => b.p!.updated_at.localeCompare(a.p!.updated_at));
+  if (touched.length > 0) {
+    const top = touched[0];
+    return { kind: "resume", lecture: top.l, position: top.p!.position };
+  }
+
+  const lastDone = lectures
+    .filter((l) => state.lectures[l.id]?.completed)
+    .sort((a, b) => (state.lectures[b.id].completed_at || "").localeCompare(state.lectures[a.id].completed_at || ""))[0];
+  if (lastDone) {
+    const sameChapter = lectures.find(
+      (l) => l.chapter === lastDone.chapter && l.subject === lastDone.subject && !state.lectures[l.id]?.completed,
+    );
+    if (sameChapter) return { kind: "next", lecture: sameChapter, position: 0 };
+  }
+
+  const first = lectures.find((l) => !state.lectures[l.id]?.completed);
+  if (first) return { kind: lastDone ? "next" : "start", lecture: first, position: 0 };
+  return { kind: "done", lecture: null, position: 0 };
+}
+
+/* ------------------------------ badges ------------------------------ */
+
+export interface Badge {
+  id: string;
+  title: string;
+  hint: string;
+  earned: boolean;
+  /** 0 to 1 */
+  progress: number;
+}
+
+export interface BadgeInput {
+  completed: number;
+  total: number;
+  bestStreak: number;
+  notes: number;
+  chaptersDone: number;
+  subjectsDone: number;
+}
+
+const ratio = (value: number, goal: number) => Math.max(0, Math.min(1, goal > 0 ? value / goal : 0));
+
+export function computeBadges(i: BadgeInput): Badge[] {
+  const half = i.total > 0 ? i.completed / i.total : 0;
+  return [
+    { id: "first-spark", title: "First Spark", hint: "Finish your first lecture", earned: i.completed >= 1, progress: ratio(i.completed, 1) },
+    { id: "on-a-roll", title: "On a Roll", hint: "Study 3 days in a row", earned: i.bestStreak >= 3, progress: ratio(i.bestStreak, 3) },
+    { id: "week-warrior", title: "Week Warrior", hint: "Study 7 days in a row", earned: i.bestStreak >= 7, progress: ratio(i.bestStreak, 7) },
+    { id: "note-taker", title: "Note Taker", hint: "Write notes on 5 lectures", earned: i.notes >= 5, progress: ratio(i.notes, 5) },
+    { id: "chapter-master", title: "Chapter Master", hint: "Complete every lecture in a chapter", earned: i.chaptersDone >= 1, progress: ratio(i.chaptersDone, 1) },
+    { id: "both-worlds", title: "Both Worlds", hint: "Finish a chapter in Physics and in Chemistry", earned: i.subjectsDone >= 2, progress: ratio(i.subjectsDone, 2) },
+    { id: "halfway", title: "Halfway There", hint: "Complete half of all lectures", earned: i.total > 0 && half >= 0.5, progress: ratio(half, 0.5) },
+  ];
+}
+
+export function badgeInputFor(lectures: LectureLite[], state: ProgressState, bestStreak: number): BadgeInput {
+  const stats = chapterStats(lectures, state);
+  const doneChapters = stats.filter((s) => s.total > 0 && s.done === s.total);
+  return {
+    completed: countCompleted(lectures, state),
+    total: lectures.length,
+    bestStreak,
+    notes: countNotes(state),
+    chaptersDone: doneChapters.length,
+    subjectsDone: new Set(doneChapters.map((s) => s.subject)).size,
+  };
+}
+
+/* ------------------------------ spaced revision ------------------------------ */
+
+export const REVISION_OFFSETS = [1, 3, 7] as const;
+
+/**
+ * Revision reminders after a lecture is finished: the next day, then 3 and 7 days later.
+ * Ids are derived from the lecture, so creating them twice is harmless.
+ */
+export function revisionPlans(lecture: LectureLite, doneDay: string): Plan[] {
+  const name = (lecture.topic || lecture.title || `Lecture ${lecture.lecture_no}`).trim();
+  return REVISION_OFFSETS.map((offset) => ({
+    id: `rev-${lecture.id}-${offset}`,
+    dateKey: addDays(doneDay, offset),
+    title: `Revise: ${name}`.slice(0, 200),
+    source: "auto" as const,
+  }));
+}
+
+/* ------------------------------ greeting ------------------------------ */
+
+export function greeting(hour: number): string {
+  if (hour < 5) return "Late-night session";
+  if (hour < 12) return "Good morning";
+  if (hour < 17) return "Good afternoon";
+  return "Good evening";
+}
+
+/* ------------------------------ time ------------------------------ */
+
+export function formatClock(totalSeconds: number): string {
+  const s = Math.max(0, Math.floor(totalSeconds));
+  const h = Math.floor(s / 3600);
+  const m = Math.floor((s % 3600) / 60);
+  const sec = s % 60;
+  return h > 0 ? `${h}:${pad(m)}:${pad(sec)}` : `${m}:${pad(sec)}`;
+}
