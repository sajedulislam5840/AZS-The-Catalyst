+    <div
+      role="status"
+      className={`flex items-start gap-3 border-b px-4 py-3 sm:px-8 ${good ? "border-sky-200 bg-sky-50 text-sky-900" : "border-amber-200 bg-amber-50 text-amber-900"}`}
