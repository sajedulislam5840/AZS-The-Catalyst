+
+/* ============================================
+   Student dashboard
+   ============================================ */
+.dash-card {
+  background: rgba(255, 255, 255, 0.88);
+  border: 1px solid #d3e3ef;
+  border-radius: 1.5rem;
+  box-shadow: 0 1px 2px rgba(7, 89, 133, 0.04), 0 10px 28px -14px rgba(7, 89, 133, 0.16);
+  -webkit-backdrop-filter: blur(10px);
+  backdrop-filter: blur(10px);
+}
+/* Blur is the most expensive paint on a phone: use a solid card there. */
+@media (max-width: 767px) {
+  .dash-card {
+    background: #fff;
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+}
+.dash-lift {
+  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
+}
+@media (hover: hover) {
+  .dash-lift:hover {
+    transform: translateY(-3px);
+    border-color: #7dd3fc;
+    box-shadow: 0 1px 2px rgba(7, 89, 133, 0.05), 0 18px 36px -16px rgba(3, 105, 161, 0.3);
+  }
+}
+.dash-lift:active {
+  transform: scale(0.985);
+}
+.dash-grid-bg {
+  background-image:
+    linear-gradient(rgba(2, 132, 199, 0.07) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(2, 132, 199, 0.07) 1px, transparent 1px);
+  background-size: 44px 44px;
+  -webkit-mask-image: radial-gradient(ellipse 80% 60% at 30% 0%, #000 0%, transparent 75%);
+  mask-image: radial-gradient(ellipse 80% 60% at 30% 0%, #000 0%, transparent 75%);
+}
+@keyframes dash-shimmer {
+  0% { background-position: 100% 50%; }
+  100% { background-position: 0 50%; }
+}
+.dash-shimmer {
+  background: linear-gradient(90deg, #e3eef6 25%, #f4f8fb 37%, #e3eef6 63%);
+  background-size: 400% 100%;
+  animation: dash-shimmer 1.4s ease infinite;
+}
+@keyframes dash-flame {
+  0%, 100% { transform: scale(1) rotate(-3deg); }
+  50% { transform: scale(1.14) rotate(3deg); }
+}
+.dash-flame {
+  animation: dash-flame 1.5s ease-in-out infinite;
+  transform-origin: 50% 90%;
+  filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.7));
+}
+@keyframes dash-confetti {
+  0% { transform: translate3d(0, 0, 0) rotate(0deg); opacity: 1; }
+  100% { transform: translate3d(var(--dx), var(--dy), 0) rotate(var(--rot)); opacity: 0; }
+}
+.dash-confetti {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  width: 9px;
+  height: 14px;
+  border-radius: 2px;
+  animation: dash-confetti 1.5s cubic-bezier(0.15, 0.7, 0.3, 1) forwards;
+}
+@keyframes dash-sheen {
+  0% { transform: translateX(-120%) skewX(-18deg); }
+  60%, 100% { transform: translateX(260%) skewX(-18deg); }
+}
+.dash-sheen::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  width: 40%;
+  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
+  animation: dash-sheen 3.6s ease-in-out infinite;
+}
+.dash-scroll-x {
+  scroll-snap-type: x proximity;
+  -webkit-overflow-scrolling: touch;
+  overscroll-behavior-x: contain;
+}
+.dash-scroll-x > * { scroll-snap-align: start; }
+.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
+@media (prefers-reduced-motion: reduce) {
+  .dash-shimmer, .dash-flame, .dash-confetti, .dash-sheen::after { animation: none; }
+  .dash-lift { transition: none; }
+}
