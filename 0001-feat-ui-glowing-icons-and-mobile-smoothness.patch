@@ -0,0 +1,38 @@
+"use client";
+
+import { useSyncExternalStore, type CSSProperties } from "react";
+import type { LucideIcon } from "lucide-react";
+import { getGlowTick, getServerGlowTick, glowColor, subscribeGlow } from "@/lib/glow";
+
+/** Current glow colour; changes every 15 seconds, shared across the whole page. */
+export function useGlowColor(offset = 0): string {
+  const tick = useSyncExternalStore(subscribeGlow, getGlowTick, getServerGlowTick);
+  return glowColor(tick, offset);
+}
+
+const BOX = { sm: "h-9 w-9 rounded-xl", md: "h-11 w-11 rounded-xl", lg: "h-14 w-14 rounded-2xl" } as const;
+const ICON = { sm: "h-[18px] w-[18px]", md: "h-5 w-5", lg: "h-7 w-7" } as const;
+
+interface GlowIconProps {
+  icon: LucideIcon;
+  /** Shift along the palette so neighbouring icons show different colours. */
+  offset?: number;
+  size?: keyof typeof BOX;
+  /** Show the soft tinted tile behind the icon. */
+  tile?: boolean;
+  className?: string;
+}
+
+/** A softly glowing icon whose colour fades to the next palette colour every 15 seconds. */
+export default function GlowIcon({ icon: Icon, offset = 0, size = "md", tile = true, className = "" }: GlowIconProps) {
+  const color = useGlowColor(offset);
+  return (
+    <span
+      className={`azs-glow relative inline-flex shrink-0 items-center justify-center ${BOX[size]} ${tile ? "azs-glow-tile" : ""} ${className}`}
+      style={{ "--glow": color } as CSSProperties}
+    >
+      <span aria-hidden="true" className="azs-glow-halo absolute inset-1.5 rounded-full" />
+      <Icon aria-hidden="true" className={`azs-glow-icon relative ${ICON[size]}`} />
+    </span>
+  );
+}
diff --git a/frontend/src/lib/glow.ts b/frontend/src/lib/glow.ts
new file mode 100644
index 0000000..f4f552a
--- /dev/null
+++ b/frontend/src/lib/glow.ts
@@ -0,0 +1,50 @@
+/**
+ * Shared colour cycle for glowing icons.
+ *
+ * One timer for the whole app (not one per icon): every `GLOW_INTERVAL_MS` the tick
+ * advances and every subscribed icon moves to its next palette colour. Icons use an
+ * `offset` so neighbours show different colours at the same moment.
+ */
+
+export const GLOW_INTERVAL_MS = 15_000;
+
+export const GLOW_PALETTE = [
+  "#0EA5E9", // sky
+  "#CC310E", // ember
+  "#F59E0B", // amber
+  "#14B8A6", // teal
+  "#8B5CF6", // violet
+] as const;
+
+/** Colour for a tick and offset; wraps around the palette and tolerates negatives. */
+export function glowColor(tick: number, offset = 0): string {
+  const n = GLOW_PALETTE.length;
+  return GLOW_PALETTE[(((tick + offset) % n) + n) % n];
+}
+
+let tick = 0;
+let timer: ReturnType<typeof setInterval> | null = null;
+const listeners = new Set<() => void>();
+
+function advance() {
+  // Save battery: no colour changes while the tab is in the background.
+  if (typeof document !== "undefined" && document.hidden) return;
+  tick += 1;
+  listeners.forEach((l) => l());
+}
+
+/** useSyncExternalStore subscribe: the timer runs only while something is listening. */
+export function subscribeGlow(listener: () => void): () => void {
+  listeners.add(listener);
+  if (timer === null) timer = setInterval(advance, GLOW_INTERVAL_MS);
+  return () => {
+    listeners.delete(listener);
+    if (listeners.size === 0 && timer !== null) {
+      clearInterval(timer);
+      timer = null;
+    }
+  };
+}
+
+export const getGlowTick = () => tick;
+export const getServerGlowTick = () => 0;
