+                <li key={s}>
+                  <button
+                    type="button"
+                    onClick={() => onFilter(s)}
+                    className="flex min-h-[56px] w-full items-center gap-3 rounded-xl border border-[#E2EDF5] bg-[#F8FBFD] px-3 py-2 text-left transition-colors hover:border-[#0369A1]"
+                  >
