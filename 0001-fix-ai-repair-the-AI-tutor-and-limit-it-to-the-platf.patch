+Run from the backend folder:
+
+    pip install pytest aiosqlite
+    DATABASE_URL=sqlite+aiosqlite:///./test.db pytest tests
+
+No network is used: the AI provider is replaced by a fake.
+"""
+import asyncio
+import os
+import uuid
+
+import httpx
+import pytest
+from fastapi import FastAPI
