+            <circle cx={LEFT} cy={GROUND} r="9" fill="#075985" />
+            {ball && <circle cx={px(ball.x)} cy={py(ball.y)} r="8" fill="#CC310E" />}
+          </svg>
+        </div>
+
+        <div className="space-y-4">
